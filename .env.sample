# ── Required by the application ──────────────────────────────────────────

# MongoDB
MONGODB_URI=string
MONGODB_DB=string

# Node environment
NODE_ENV=string

# Admin panel credentials
# ADMIN_PASSWORD_HASH is a bcrypt hash — generate with:
#   node -e "console.log(require('bcrypt').hashSync(process.argv[1], 12))" 'your-password'
ADMIN_USERNAME=string
ADMIN_PASSWORD_HASH=string
# There is no plaintext fallback. ADMIN_PASSWORD was removed: it kept a second
# copy of the credential in the environment, and an unset or typo'd hash
# silently downgraded admin auth to a plaintext compare instead of failing.
# Without ADMIN_PASSWORD_HASH, admin login is disabled.

# NextAuth.js
NEXTAUTH_SECRET=string
NEXTAUTH_URL=string

# Twilio (operator SMS on new bookings and contact submissions)
TWILIO_ACCOUNT_SID=string
TWILIO_AUTH_TOKEN=string
TWILIO_PHONE_NUMBER=string
USER_PHONE_NUMBER=string

# Resend (customer and operator email)
RESEND_API_KEY=string

# PayPal (optional online payment on the /order review step).
#
# All three unset means the feature ships dark: no buttons render and checkout
# behaves exactly as it did before, taking the booking and invoicing later.
#
# NEXT_PUBLIC_PAYPAL_CLIENT_ID is inlined at BUILD time, so setting it in
# Vercel does nothing until the next deploy — and it can diverge from the two
# server values, which renders buttons against a route that 503s. The route
# says so in customer-readable terms for exactly that reason.
#
# There is no sandbox switch: src/lib/paypal/client.ts hardcodes the live API
# base. A developer verifying the flow edits PAYPAL_API_BASE locally.
PAYPAL_CLIENT_ID=string
PAYPAL_CLIENT_SECRET=string
NEXT_PUBLIC_PAYPAL_CLIENT_ID=string
# The webhook's id from the PayPal dashboard, which is what its signature is
# verified against. Unset ships the webhook dark: the route 503s and PayPal
# retries, so an approval whose capture call never arrived — and an eCheck that
# settles days later — are simply never finished. Like the pair above, this is
# read at request time but injected at deploy time, so a change needs a
# redeploy.
PAYPAL_WEBHOOK_ID=string

# Google Tag Manager container id, e.g. GTM-XXXXXXX. The container currently
# carries only the Google Ads conversion tags, not GA4.
NEXT_PUBLIC_GTM_ID=string

# GA4 measurement id, e.g. G-XXXXXXXXXX. This is the only path by which GA4
# receives data — leave it unset and the site stops reporting entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=string

# Vercel Cron — authorises /api/cron/release-holds, which frees abandoned
# rental holds. The endpoint refuses to run when this is unset.
CRON_SECRET=string

# ── Shared rate-limit store ──────────────────────────────────────────────
# Provisioned by the Upstash for Redis Marketplace integration, which sets the
# KV_REST_API_* pair below. Rate limiting falls back to per-instance memory
# when these are absent, which throttles a single client but is not shared
# across instances — so a caller spread over N instances gets N x the limit.
# The limiter also accepts UPSTASH_REDIS_REST_URL / _TOKEN, Upstash's own
# names, for a deployment configured by hand instead.
KV_REST_API_URL=string
KV_REST_API_TOKEN=string

# ── Optional / external tooling ──────────────────────────────────────────
# Not read anywhere in src/. Present in the deployed environment for the
# QuickBooks integration and the Resend webhook receiver, which live outside
# this repository. Listed so the environment can be reproduced.

DEFAULT_EMAIL_FROM=string
RESEND_WEBHOOK_SECRET=string

QB_CLIENT_ID=string
QB_CLIENT_SECRET=string
QB_REALM_ID=string
QB_REDIRECT_URI=string
QB_ENVIRONMENT=string
QB_AUTHORIZATION_CODE=string

# Optional. Google Business "write a review" link. When unset, the review CTA
# on /success is not rendered.
NEXT_PUBLIC_GOOGLE_REVIEW_URL=

# Google Maps JavaScript API browser key (admin delivery-zone map).
# Create in Google Cloud console, restrict to Websites + Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ── Partner order webhook (bounce-v3) ────────────────────────────────────
# Both businesses run out of one depot, with one truck and one crew, so a
# margarita booking is a real claim on the same day's capacity. Orders are
# pushed to bounce-v3 so one admin list, one calendar and one revenue rollup
# cover both.
#
# Both unset ships the feature dark: no outbox rows are written and checkout
# behaves exactly as it did before, the same contract the PayPal pair carries.
#
# The secret is deliberately NOT bounce-v3's WEBHOOK_SHARED_SECRET, which
# PartyPad holds. Check the far end with:
#   curl -s https://satxbounce.com/api/v1/webhooks/partner-orders | jq .configured
PARTNER_WEBHOOK_URL=
PARTNER_WEBHOOK_SECRET=
