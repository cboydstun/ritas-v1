# ── Required by the application ──────────────────────────────────────────

# MongoDB
MONGODB_URI=string
MONGODB_DB=string

# Node environment
NODE_ENV=string

# Admin panel credentials
# ADMIN_PASSWORD_HASH is a bcrypt hash — generate with:
#   node -e "console.log(require('bcrypt').hashSync(process.argv[1], 12))" 'your-password'
ADMIN_USERNAME=string
ADMIN_PASSWORD_HASH=string

# NextAuth.js
NEXTAUTH_SECRET=string
NEXTAUTH_URL=string

# Twilio (operator SMS on new bookings and contact submissions)
TWILIO_ACCOUNT_SID=string
TWILIO_AUTH_TOKEN=string
TWILIO_PHONE_NUMBER=string
USER_PHONE_NUMBER=string

# Resend (customer and operator email)
RESEND_API_KEY=string

# Google Tag Manager container id, e.g. GTM-XXXXXXX. The container currently
# carries only the Google Ads conversion tags, not GA4.
NEXT_PUBLIC_GTM_ID=string

# GA4 measurement id, e.g. G-XXXXXXXXXX. This is the only path by which GA4
# receives data — leave it unset and the site stops reporting entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=string

# Vercel Cron — authorises /api/cron/release-holds, which frees abandoned
# rental holds. The endpoint refuses to run when this is unset.
CRON_SECRET=string

# ── Optional: shared rate-limit store ────────────────────────────────────
# Rate limiting falls back to per-instance memory when these are absent,
# which throttles a single client but is not shared across instances.
UPSTASH_REDIS_REST_URL=string
UPSTASH_REDIS_REST_TOKEN=string

# ── Optional / external tooling ──────────────────────────────────────────
# Not read anywhere in src/. Present in the deployed environment for the
# QuickBooks integration and the Resend webhook receiver, which live outside
# this repository. Listed so the environment can be reproduced.

DEFAULT_EMAIL_FROM=string
RESEND_WEBHOOK_SECRET=string

QB_CLIENT_ID=string
QB_CLIENT_SECRET=string
QB_REALM_ID=string
QB_REDIRECT_URI=string
QB_ENVIRONMENT=string
QB_AUTHORIZATION_CODE=string
